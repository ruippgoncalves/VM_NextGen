{
  "name": "ewvm-code",
  "displayName": "EWVM for VS Code",
  "description": "Visual execution and debugging tool for EWVM virtual machine",
  "version": "0.0.0",
  "type": "module",
  "publisher": "ewvm",
  "repository": {
    "type": "git",
    "url": "https://github.com/ruippgoncalves/VM_NextGen"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ewvm",
        "aliases": [
          "EWVM",
          "ewvm"
        ],
        "extensions": [
          ".vm",
          ".ewvm"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ewvm",
        "scopeName": "source.ewvm",
        "path": "./syntaxes/ewvm.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "ewvm-code.runToSide",
        "title": "EWVM: Run to Side",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "ewvm-code.runToSide",
          "when": "editorLangId == ewvm || resourceExtname == .vm || resourceExtname == .ewvm",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "ewvm-code.runToSide",
          "when": "editorLangId == ewvm || resourceExtname == .vm || resourceExtname == .ewvm",
          "group": "1_modification"
        }
      ]
    }
  },
  "scripts": {
    "generate:syntax": "node scripts/generate-syntax.mjs",
    "precompile": "npm run generate:syntax",
    "vscode:prepublish": "npm run generate:syntax && npm run compile && npm run build:webview",
    "compile": "npm run generate:syntax && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:webview": "vite build --config vite.webview.config.ts",
    "package": "npm run generate:syntax && npm run compile && npm run build:webview && vsce package --no-dependencies --allow-missing-repository -o ../frontend/public/ewvm-code.vsix && node -e \"const fs=require('fs'); fs.copyFileSync('../frontend/public/ewvm-code.vsix', './ewvm-code.vsix')\""
  },
  "dependencies": {
    "ewvm": "file:../ewvm",
    "ewvm-vue": "file:../ewvm-vue",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.4.2",
    "vite": "^5.1.4"
  }
}
